# Шаблон конфигурации для запуска на домашнем ПК / Windows (docker-compose.local.yml).
# Скопируйте этот файл в .env.local (или просто запустите scripts\local.ps1 — он создаст его автоматически).

# 1. Публичный HTTPS-адрес вашего сервера (например https://tactic.ваш-домен.com).
#    Оставьте пустым, если хотите использовать бесплатный временный туннель *.trycloudflare.com.
PUBLIC_URL=https://tactic.example.com

# 2. Токен вашего именного Cloudflare Tunnel (из панели Cloudflare Zero Trust -> Networks -> Tunnels).
#    В настройках туннеля укажите Public Hostname -> Service: http://caddy:80
#    Оставьте пустым для автоматического временного туннеля без своего домена.
CLOUDFLARE_TUNNEL_TOKEN=

# 3. Логин и пароль для входа в Админ-панель (создание бойцов и управление сетями). Пароль — минимум 10 символов,
#    значения из этого примера сервер не примет (scripts\local.ps1 сам сгенерирует случайные).
ADMIN_USER=administrator
ADMIN_PASSWORD=change-me-admin-pass

# 4. Секретный ключ для подписи JWT-токенов (минимум 32 случайных символа)
JWT_SECRET=change-me-random-jwt-secret-at-least-32-chars
