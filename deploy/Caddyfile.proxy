# Plain-HTTP Caddy behind a TLS front: Cloudflare Tunnel (docker-compose.local.yml) or another
# reverse proxy (docker-compose.proxy.yml). TLS is terminated in front of it.
{
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

:80 {
	encode zstd gzip

	reverse_proxy app:3000

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Permissions-Policy "geolocation=(self), microphone=(self), screen-wake-lock=(self)"
		-Server
	}
}
