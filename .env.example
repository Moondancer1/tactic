# ---- Public endpoint ----
# Domain with an A record pointing to this VPS (Caddy gets a Let's Encrypt cert for it)
DOMAIN=tactic.example.com
# Email for ACME / Let's Encrypt notices
ACME_EMAIL=admin@example.com
# Public IPv4 of the VPS (used by coturn and LiveKit for ICE candidates)
PUBLIC_IP=203.0.113.10

# ---- App secrets (generate with: ./scripts/gen-env.sh) ----
JWT_SECRET=change-me-64-hex
# Bearer token for admin endpoints (create matches, webhook events)
ADMIN_TOKEN=change-me-admin-token

# ---- Voice (LiveKit SFU) ----
LIVEKIT_API_KEY=tactic
LIVEKIT_API_SECRET=change-me-livekit-secret-min-32-chars

# ---- TURN (coturn) ----
TURN_USER=tactic
TURN_PASSWORD=change-me-turn-password

# ---- Optional ----
# Extra CORS origins for the web client (comma separated). Capacitor origins are always allowed.
CORS_ORIGINS=
# Days to keep match history (chat, tracks)
RETENTION_DAYS=30
