# ---- Public endpoint ----
# Domain with an A record pointing to this VPS (Caddy gets a Let's Encrypt cert for it)
DOMAIN=tactic.example.com
# Email for ACME / Let's Encrypt notices
ACME_EMAIL=admin@example.com

# ---- App secrets: generate with ./scripts/gen-env.sh (the server refuses to start with these placeholders) ----
JWT_SECRET=change-me-64-hex
# Admin panel credentials (manage fighters and networks). At least 10 characters.
ADMIN_USER=administrator
ADMIN_PASSWORD=change-me-admin-password
# Optional bearer token for admin API scripts / webhook events
ADMIN_TOKEN=change-me-admin-token

# ---- Optional ----
# Extra origins allowed to call the API cross-origin (the APK's https://localhost is always allowed).
CORS_ORIGINS=
# Days to keep match history (chat, tracks, ended networks)
RETENTION_DAYS=30
