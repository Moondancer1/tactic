<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Same dark palette as the web app (client/src/styles.css): no light system bars around a dark map. -->
    <color name="tactic_bg">#0B0F0C</color>
    <color name="tactic_bar">#080B09</color>
    <color name="tactic_accent">#9BD35A</color>

    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/tactic_bar</item>
        <item name="colorPrimaryDark">@color/tactic_bar</item>
        <item name="colorAccent">@color/tactic_accent</item>
        <item name="android:windowBackground">@color/tactic_bg</item>
        <item name="android:statusBarColor">@color/tactic_bar</item>
        <item name="android:navigationBarColor">@color/tactic_bg</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="colorPrimary">@color/tactic_bar</item>
        <item name="colorPrimaryDark">@color/tactic_bar</item>
        <item name="colorAccent">@color/tactic_accent</item>
        <item name="android:windowBackground">@color/tactic_bg</item>
        <item name="android:statusBarColor">@color/tactic_bar</item>
        <item name="android:navigationBarColor">@color/tactic_bg</item>
    </style>

    <!-- Launch: Android 12+ draws the system splash (adaptive icon on this background); older versions show @drawable/splash. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/tactic_bg</item>
        <item name="android:statusBarColor">@color/tactic_bar</item>
        <item name="android:navigationBarColor">@color/tactic_bg</item>
    </style>
</resources>
