<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, system CAs only (user-installed CAs cannot MITM the app on a hostile field Wi-Fi). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
